# 大模型 API 配置（请替换为你的真实 API Key）
AGENT_OPENAI_API_KEY=sk-your-api-key-here
AGENT_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_OPENAI_MODEL=qwen3.7-max-2026-05-17
AGENT_CLASSIFIER_MODEL=qwen3.7-max-2026-05-17

# RAG 重排序模型（可选）
AGENT_EMBEDDING_MODEL=text-embedding-v4
AGENT_RAG_RERANK_ENABLED=true
AGENT_RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
AGENT_RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
